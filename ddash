func openContainerLogs(server, container string) tea.Cmd {
    return exec.Command("tmux", "new-window", "-n", fmt.Sprintf("logs-%s", container),
        "ssh", "-t", server, "docker", "logs", "-f", container).Run
}

func openContainerShell(server, container string) tea.Cmd {
    return exec.Command("tmux", "new-window", "-n", fmt.Sprintf("shell-%s", container),
        "ssh", "-t", server, "docker", "exec", "-it", container, "bash").Run
}

