// ContainerStats holds the information we want to display for each container
type ContainerStats struct {
    Name        string
    Status      string
    CPU         float64
    Memory      float64
    Network     string
    Mounts      []string
    Environment []string
}

// Model represents the application state
type Model struct {
    containerTable   table.Model
    detailsViewport viewport.Model
    spinner         spinner.Model
    help            help.Model
    keys            keyMap
    servers         []string
    currentServer   string
    selectedContainer string
    showDetails     bool
    loading         bool
    error          error
    height         int
    width          int
}

// keyMap defines all the possible actions
type keyMap struct {
    Up       key.Binding
    Down     key.Binding
    Tab      key.Binding
    Enter    key.Binding
    Details  key.Binding
    Refresh  key.Binding
    Logs     key.Binding
    Shell    key.Binding
    Quit     key.Binding
}

func (k keyMap) ShortHelp() []key.Binding {
    return []key.Binding{k.Up, k.Down, k.Tab, k.Enter, k.Quit}
}

func (k keyMap) FullHelp() [][]key.Binding {
    return [][]key.Binding{
        {k.Up, k.Down, k.Tab},
        {k.Enter, k.Details, k.Refresh},
        {k.Logs, k.Shell, k.Quit},
    }
}

func initialModel() Model {
    // Define keyboard shortcuts
    keys := keyMap{
        Up: key.NewBinding(
            key.WithKeys("up"),
            key.WithHelp("↑", "move up"),
        ),
        Down: key.NewBinding(
            key.WithKeys("down"),
            key.WithHelp("↓", "move down"),
        ),
        Tab: key.NewBinding(
            key.WithKeys("tab"),
            key.WithHelp("tab", "switch server"),
        ),
        Enter: key.NewBinding(
            key.WithKeys("enter"),
            key.WithHelp("enter", "select"),
        ),
        Details: key.NewBinding(
            key.WithKeys("d"),
            key.WithHelp("d", "toggle details"),
        ),
        Refresh: key.NewBinding(
            key.WithKeys("r"),
            key.WithHelp("r", "refresh"),
        ),
        Logs: key.NewBinding(
            key.WithKeys("l"),
            key.WithHelp("l", "view logs"),
        ),
        Shell: key.NewBinding(
            key.WithKeys("s"),
            key.WithHelp("s", "open shell"),
        ),
        Quit: key.NewBinding(
            key.WithKeys("q", "ctrl+c"),
            key.WithHelp("q", "quit"),
        ),
    }

    // Initialize table columns
    columns := []table.Column{
        {Title: "NAME", Width: 30},
        {Title: "STATUS", Width: 15},
        {Title: "CPU %", Width: 10},
        {Title: "MEM %", Width: 10},
        {Title: "NETWORK", Width: 15},
    }

    // Create and style the table
    t := table.New(
        table.WithColumns(columns),
        table.WithFocused(true),
        table.WithHeight(10),
    )

    // Style the table
    s := table.DefaultStyles()
    s.Header = s.Header.
        BorderStyle(lipgloss.NormalBorder()).
        BorderForeground(lipgloss.Color("240")).
        BorderBottom(true).
        Bold(false)
    s.Selected = s.Selected.
        Foreground(lipgloss.Color("229")).
        Background(lipgloss.Color("57")).
        Bold(false)
    t.SetStyles(s)

    // Initialize the viewport for details
    vp := viewport.New(80, 20)
    vp.Style = lipgloss.NewStyle().
        BorderStyle(lipgloss.RoundedBorder()).
        BorderForeground(lipgloss.Color("240")).
        Padding(1)

    // Initialize spinner for loading states
    sp := spinner.New()
    sp.Spinner = spinner.Dot
    sp.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("205"))

    return Model{
        containerTable:   t,
        detailsViewport: vp,
        spinner:         sp,
        help:            help.New(),
        keys:           keys,
        servers:        []string{"172.20.0.21", "172.20.96.20"},
        currentServer:  "172.20.0.21",
        loading:        false,
    }
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
    var (
        cmd  tea.Cmd
        cmds []tea.Cmd
    )

    switch msg := msg.(type) {
    case tea.KeyMsg:
        // Handle key presses
        switch {
        case key.Matches(msg, m.keys.Quit):
            return m, tea.Quit
        case key.Matches(msg, m.keys.Tab):
            // Switch server
            for i, s := range m.servers {
                if s == m.currentServer {
                    m.currentServer = m.servers[(i+1)%len(m.servers)]
                    break
                }
            }
            m.loading = true
            return m, getContainerInfo(m.currentServer)
        case key.Matches(msg, m.keys.Details):
            m.showDetails = !m.showDetails
            if m.showDetails {
                return m, getContainerDetails(m.currentServer, m.selectedContainer)
            }
        case key.Matches(msg, m.keys.Logs):
            if m.selectedContainer != "" {
                return m, openContainerLogs(m.currentServer, m.selectedContainer)
            }
        case key.Matches(msg, m.keys.Shell):
            if m.selectedContainer != "" {
                return m, openContainerShell(m.currentServer, m.selectedContainer)
            }
        }
    
    case tea.WindowSizeMsg:
        m.height = msg.Height
        m.width = msg.Width
        m.containerTable.SetHeight(m.height - 10)
        m.detailsViewport.Height = m.height - 10
        m.detailsViewport.Width = m.width
    }

    // Update sub-components
    if m.loading {
        m.spinner, cmd = m.spinner.Update(msg)
        cmds = append(cmds, cmd)
    }

    m.containerTable, cmd = m.containerTable.Update(msg)
    cmds = append(cmds, cmd)

    if m.showDetails {
        m.detailsViewport, cmd = m.detailsViewport.Update(msg)
        cmds = append(cmds, cmd)
    }

    return m, tea.Batch(cmds...)
}

func (m Model) View() string {
    var b strings.Builder

    // Server header
    b.WriteString(fmt.Sprintf("\n 🖥  Current Server: %s\n\n", m.currentServer))

    // Main content
    if m.loading {
        b.WriteString(m.spinner.View() + " Loading...")
    } else {
        b.WriteString(m.containerTable.View())
        if m.showDetails {
            b.WriteString("\n\n" + m.detailsViewport.View())
        }
    }

    // Help footer
    b.WriteString("\n\n" + m.help.View(m.keys))

    return b.String()
}

