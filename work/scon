#!/bin/bash

# scon - SSH Connection Selector
# Place this script in ~/bin/scon and make it executable (chmod +x ~/bin/scon)

CONFIG_FILE="$HOME/lib/work/config.json"

# Check if config file exists
if [ ! -f "$CONFIG_FILE" ]; then
    echo "Error: Config file not found at $CONFIG_FILE"
    exit 1
fi

# Get SSH key from config
ssh_key=$(jq -r '.ssh_key' "$CONFIG_FILE")

# Get hosts from SSH config
hosts=$(grep "^Host " ~/.ssh/config | grep -v "\*" | cut -d " " -f2-)

if [ -z "$hosts" ]; then
    echo "No hosts found in SSH config"
    exit 1
fi

# Get additional info for each host
formatted_hosts=""
while IFS= read -r host; do
    # Get host details from SSH config
    ip=$(awk "/^Host $host\$/,/^$/ { if (\$1 == \"HostName\") print \$2 }" ~/.ssh/config)
    user=$(awk "/^Host $host\$/,/^$/ { if (\$1 == \"User\") print \$2 }" ~/.ssh/config)
    formatted_hosts+=$(printf "%-20s %-20s %s\n" "$host" "$user" "$ip")
done <<< "$hosts"

# Select host using fzf
selected_host=$(echo "$formatted_hosts" | \
    fzf --prompt="Select host: " --header="HOST                USER                IP")

if [ -z "$selected_host" ]; then
    exit 0
fi

host_name=$(echo "$selected_host" | awk '{print $1}')

# Connect to the selected host using the SSH key from config
echo "Connecting to $host_name..."
ssh -i "$ssh_key" "$host_name"
