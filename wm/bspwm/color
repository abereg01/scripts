#!/usr/bin/env bash

# Constants
COLOR_DIR="$HOME/dotfiles/theme/colors"
CONFIG_DIR="$HOME/.config"

# Function to list available color schemes
list_colorschemes() {
    find "$COLOR_DIR" -mindepth 1 -maxdepth 1 -type d -printf "%f\n" | sort
}

# Function to select color scheme using a floating terminal with fzf
select_color() {
    kitty --name float --class float \
        -o remember_window_size=no \
        -o initial_window_width=100c \
        -o initial_window_height=20c \
        -e fish -c "find \"$COLOR_DIR\" -mindepth 1 -maxdepth 1 -type d -printf \"%f\n\" | sort | \
        fzf --header=\"Select Theme\" --preview=\"$HOME/lib/scripts/wm/bspwm/preview_theme.sh {}\" \
        --preview-window=top:8 > /tmp/selected_theme.txt" 2>/dev/null

    # Read the selected theme from the temporary file
    if [ -f /tmp/selected_theme.txt ]; then
        selected=$(cat /tmp/selected_theme.txt)
        rm /tmp/selected_theme.txt
        echo "$selected"
    fi
}

# Select color scheme
color=$(select_color)

# Exit if no color scheme was selected
[[ -z "$color" ]] && exit 0

# Check if the selected color scheme exists
[[ -d "$COLOR_DIR/$color" ]] || { echo "Invalid color scheme: $color"; exit 1; }

# Function to read color values from .conf file
read_color_values() {
    local conf_file="$COLOR_DIR/$color/$color.conf"
    if [[ ! -f "$conf_file" ]]; then
        echo "Color configuration file not found: $conf_file"
        exit 1
    fi

    # Read color values
    background=$(grep '^background\b' "$conf_file" | awk '{print $2}')
    foreground=$(grep '^foreground\b' "$conf_file" | awk '{print $2}')
    color0=$(grep '^color0\b' "$conf_file" | awk '{print $2}')  # black
    color1=$(grep '^color1\b' "$conf_file" | awk '{print $2}')  # red
    color2=$(grep '^color2\b' "$conf_file" | awk '{print $2}')  # green
    color3=$(grep '^color3\b' "$conf_file" | awk '{print $2}')  # yellow
    color4=$(grep '^color4\b' "$conf_file" | awk '{print $2}')  # blue
    color5=$(grep '^color5\b' "$conf_file" | awk '{print $2}')  # magenta
    color6=$(grep '^color6\b' "$conf_file" | awk '{print $2}')  # cyan
    color7=$(grep '^color7\b' "$conf_file" | awk '{print $2}')  # white
}

# Call the function to read color values
read_color_values

# Function to generate feh background configuration
generate_fehbg() {
    echo "feh --no-fehbg --bg-fill $COLOR_DIR/$color/wall/" > "$HOME/.fehbg"
    chmod 755 "$HOME/.fehbg"
}

lockscreen() {
    # Check if cached images exist for this theme
    if ! ls "$HOME/.cache/betterlockscreen/$color"* >/dev/null 2>&1; then
        echo "Updating lockscreen..."
        betterlockscreen -u "$COLOR_DIR/$color/wall"
    fi
}

# Function to update terminal colors
update_terminal_colors() {
    cp "$COLOR_DIR/$color/$color.conf" "$CONFIG_DIR/kitty/theme.conf"
    killall -SIGUSR1 kitty
}

# Function to map theme names for NvChad
get_nvchad_theme() {
    case "$1" in
        "dracula")
            echo "chadracula"
            ;;
        "gruvbox")
            echo "gruvchad"
            ;;
        *)
            echo "$1"
            ;;
    esac
}

# Function to update UI colors
update_ui_colors() {
    # Update BSPWM colors
    sed -i -e "s/bspc config normal_border_color .*/bspc config normal_border_color \"$color0\"/g" \
           -e "s/bspc config focused_border_color .*/bspc config focused_border_color \"$color4\"/g" \
           "$CONFIG_DIR/bspwm/config"

    # Update Polybar
    sed -i -e "s/background = .*/background = $background/g" \
        -i -e "s/foreground = .*/foreground = $foreground/g" \
        -i -e "s/accent = .*/accent = $color4/g" \
        -i -e "s/alert = .*/alert = $color1/g" \
        -i -e "s/red = .*/red = $color1/g" \
        -i -e "s/cyan = .*/cyan = $color6/g" \
        -i -e "s/blue = .*/blue = $color4/g" \
        -i -e "s/magenta = .*/magenta = $color5/g" \
        -i -e "s/yellow = .*/yellow = $color3/g" \
        -i -e "s/green = .*/green = $color2/g" \
        "$HOME/.config/polybar/colors.ini"

    # Update Dunst colors
    sed -i -e "s/background = .*/background = \"$background\"/g" \
           -e "s/foreground = .*/foreground = \"$foreground\"/g" \
           "$CONFIG_DIR/dunst/dunstrc"

    # Update btop colors and config
    # Update theme setting in btop.conf
    sed -i "s/color_theme = \".*\"/color_theme = \"$color\"/" "$CONFIG_DIR/btop/btop.conf"
    
    # Create theme file
    cat > "$CONFIG_DIR/btop/themes/$color.theme" << EOF
theme[main_bg]=$background
theme[main_fg]=$foreground
theme[title]=$color4
theme[hi_fg]=$color6
theme[selected_bg]=$color4
theme[selected_fg]=$background
theme[inactive_fg]=$color8
theme[graph_text]=$color7
theme[meter_bg]=$color0
theme[process_start]=$color2
theme[process_mid]=$color3
theme[process_end]=$color1
EOF

    # Update lf colors
    cat > "$CONFIG_DIR/lf/colors" << EOF
di $color4
fi $foreground
ln $color6
ex $color2
or $color1
EOF

    # Update bemenu colors
    sed -i -e "s/BG=\"[^\"]*\"/BG=\"$background\"/g" \
           -e "s/FG=\"[^\"]*\"/FG=\"$foreground\"/g" \
           -e "s/HIGHLIGHT=\"[^\"]*\"/HIGHLIGHT=\"$color4\"/g" \
           "$HOME/dotfiles/configs/bemenu/bmenu"

    # Update NvChad theme with mapped name
    nvchad_theme=$(get_nvchad_theme "$color")
    sed -i "s/theme = \"[^\"]*\"/theme = \"$nvchad_theme\"/" \
           "$HOME/dotfiles/configs/nvim/lua/chadrc.lua"
    
    # Try to update running NvChad instance
    NVIM_SERVER="$HOME/.cache/nvim/nvchad_pipe"
    if [ -S "$NVIM_SERVER" ]; then
        nvim --server "$NVIM_SERVER" --remote-send "<cmd>lua require('base46').load_all_highlights(); vim.cmd('redraw!')<CR>"
    else
        # Fallback to headless update if no server running
        nvim --headless +"lua require('base46').load_all_highlights()" +q
    fi

    # Update BSPWM user options
    sed -i -e "s/bsp_color=.*/bsp_color=$color/g" "$CONFIG_DIR/bspwm/config"

    # Update BAT theme
    sed -i "s/--theme=\"[^\"]*\"/--theme=\"$color\"/" \
           "$CONFIG_DIR/bat/bat.conf"
           
    # Update Zathura colors
    cat > "$HOME/dotfiles/configs/zathura/zathurarc" << EOF
# Zathura configuration file
set notification-error-bg "$background"
set notification-error-fg "$color1"
set notification-warning-bg "$background"
set notification-warning-fg "$color3"
set notification-bg "$background"
set notification-fg "$foreground"

set completion-group-bg "$background"
set completion-group-fg "$color4"
set completion-bg "$background"
set completion-fg "$foreground"
set completion-highlight-bg "$color4"
set completion-highlight-fg "$background"

set index-bg "$background"
set index-fg "$foreground"
set index-active-bg "$color4"
set index-active-fg "$background"

set inputbar-bg "$background"
set inputbar-fg "$foreground"
set statusbar-bg "$background"
set statusbar-fg "$foreground"

set highlight-color "$color4"
set highlight-active-color "$color6"

set default-bg "$background"
set default-fg "$foreground"

set render-loading true
set render-loading-fg "$foreground"
set render-loading-bg "$background"

set recolor true
set recolor-lightcolor "$background"
set recolor-darkcolor "$foreground"
EOF
}

generate_colors_fzf() {
    local fish_colors_file="$HOME/.config/fish/custom/fzfcolors.fish"
    echo "# Color configuration" > "$fish_colors_file"
    echo "set -g color_background $background" >> "$fish_colors_file"
    echo "set -g color_foreground $foreground" >> "$fish_colors_file"
    echo "set -g color_black $color0" >> "$fish_colors_file"
    echo "set -g color_red $color1" >> "$fish_colors_file"
    echo "set -g color_green $color2" >> "$fish_colors_file"
    echo "set -g color_yellow $color3" >> "$fish_colors_file"
    echo "set -g color_blue $color4" >> "$fish_colors_file"
    echo "set -g color_magenta $color5" >> "$fish_colors_file"
    echo "set -g color_cyan $color6" >> "$fish_colors_file"
    echo "set -g color_white $color7" >> "$fish_colors_file"
    echo "" >> "$fish_colors_file"
    echo "# Additional color mappings for fzf" >> "$fish_colors_file"
    echo "set -g color_fg \$color_foreground" >> "$fish_colors_file"
    echo "set -g color_bg \$color_background" >> "$fish_colors_file"
    echo "set -g color_hl \$color_yellow" >> "$fish_colors_file"
    echo "set -g color_fg_plus \$color_white" >> "$fish_colors_file"
    echo "set -g color_bg_plus \$color_black" >> "$fish_colors_file"
    echo "set -g color_hl_plus \$color_yellow" >> "$fish_colors_file"
    echo "set -g color_border \$color_black" >> "$fish_colors_file"
    echo "set -g color_header \$color_blue" >> "$fish_colors_file"
    echo "set -g color_gutter \$color_background" >> "$fish_colors_file"
    echo "set -g color_spinner \$color_yellow" >> "$fish_colors_file"
    echo "set -g color_info \$color_cyan" >> "$fish_colors_file"
    echo "set -g color_pointer \$color_magenta" >> "$fish_colors_file"
    echo "set -g color_marker \$color_red" >> "$fish_colors_file"
    echo "set -g color_prompt \$color_foreground" >> "$fish_colors_file"
}

update_cava_colors() {
    local cava_config="$CONFIG_DIR/cava/config"
    
    # Create gradient colors from the theme colors
    # We'll use a combination of blue, cyan, and foreground colors for the gradient
    local gradient_colors=(
        "$color4"  # blue
        "$color4"  # blue (repeated for smooth transition)
        "$color6"  # cyan
        "$color7"  # white/foreground
    )
    
    # Ensure the color format is correct (convert from RGB to hex if needed)
    for i in "${!gradient_colors[@]}"; do
        local color="${gradient_colors[$i]}"
        # Remove leading '#' if present and add it back
        color="#${color#\#}"
        gradient_colors[$i]="$color"
    done

    # First, ensure gradient is enabled
    sed -i 's/^gradient = .*/gradient = 1/' "$cava_config"
    sed -i 's/^gradient_count = .*/gradient_count = 4/' "$cava_config"
    
    # Then update each color line precisely
    sed -i "s/^gradient_color_1 = .*$/gradient_color_1 = '${gradient_colors[0]}'/" "$cava_config"
    sed -i "s/^gradient_color_2 = .*$/gradient_color_2 = '${gradient_colors[1]}'/" "$cava_config"
    sed -i "s/^gradient_color_3 = .*$/gradient_color_3 = '${gradient_colors[2]}'/" "$cava_config"
    sed -i "s/^gradient_color_4 = .*$/gradient_color_4 = '${gradient_colors[3]}'/" "$cava_config"
   
    # Restart cava if it's running
    if pgrep -x "cava" >/dev/null; then
        pkill -USR1 cava
    fi
}

# Function to update lockscreen
lockscreen() {
    # Only update if current blur wallpaper doesn't match our theme wallpaper
    current_wallpaper=$(readlink -f "$COLOR_DIR/$color/wall")
    cache_wallpaper=$(grep -o '".*"' "$HOME/.cache/betterlockscreen/wall_cache.txt" 2>/dev/null | tr -d '"')
    
    if [ "$current_wallpaper" != "$cache_wallpaper" ]; then
        echo "Updating lockscreen..."
        betterlockscreen -u "$COLOR_DIR/$color/wall" --fx blur
    fi
}

# Function to restart necessary services
restart_services() {
    bspc wm -r
    pkill -USR1 -x sxhkd
    sleep 1
}

# Main function
main() {
    generate_fehbg
    update_terminal_colors
    update_ui_colors
    generate_colors_fzf
    update_cava_colors
    restart_services
    
    # Update lockscreen in background after theme change
    "$HOME/lib/scripts/wm/bspwm/update_lockscreen.sh" &
}

# Run the main function
main
exit 0
